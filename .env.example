# Generate private local credentials with pnpm setup:dev. Never commit .env.
DATABASE_URL=postgres://opentradie:change-me@127.0.0.1:5432/opentradie
POSTGRES_PASSWORD=change-me
SESSION_SECRET=replace-with-at-least-32-random-bytes
TENANT_ID=11111111-1111-4111-8111-111111111111
OWNER_EMAIL=owner@demo.opentradie.test
OWNER_PASSWORD=replace-with-a-strong-unique-password
VIEWER_EMAIL=viewer@demo.opentradie.test
VIEWER_PASSWORD=replace-with-another-strong-password
DEPLOYMENT_PROFILE=local
PRIVACY_MODE=LOCAL_ONLY
AGENT_MODE=mock
MODEL_LOCATION=local
APP_ORIGIN=http://localhost:5173
PORT=3000
# Real OpenClaw requires a separate isolated, paired, tools-denied Gateway.
OPENCLAW_URL=ws://127.0.0.1:18789
OPENCLAW_TOKEN=
OPENCLAW_DEVICE_PATH=.data/openclaw-device.json
# Exact provider/model configuration instructions in docs/OPENCLAW_INTEGRATION.md
FILE_STORE=local
FILE_STORE_PATH=.data/files
# AES-256-GCM key: 32 random bytes as hex, generated during setup
CREDENTIAL_ENCRYPTION_KEY=
