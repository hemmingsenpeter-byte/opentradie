# OPENTRADIE configuration. `pnpm setup:dev` copies this to .env and generates the secrets.
# Never commit .env. The same variables configure every deployment profile.

# --- Deployment ---
# local | cloud | hybrid (a migration, not a toggle)
DEPLOYMENT_PROFILE=local
# optional; defaults to install-<first 8 chars of TENANT_ID>
INSTALLATION_ID=
# the API/worker only run on the single authoritative runtime
AUTHORITATIVE_RUNTIME=true
# browser origin; mutations must send a matching Origin header
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3000
# Requests per minute per client IP (default 300; login has its own stricter limit).
# RATE_LIMIT_PER_MINUTE=300
# must be true in the cloud profile (HTTPS)
SECURE_COOKIES=false
LOG_LEVEL=info
# run the background worker inside the API process
RUN_WORKER=true
# apply pending migrations when the API starts (useful for containers)
MIGRATE_ON_START=false

# --- Database ---
DATABASE_URL=postgres://opentradie:change-me@127.0.0.1:5432/opentradie
# Docker Compose Postgres password (keep in sync with DATABASE_URL)
POSTGRES_PASSWORD=change-me
# setup:dev sets true to use embedded PostgreSQL 17 in .data/postgres (dev only)
DEV_EMBEDDED_POSTGRES=false
# tests: admin URL of a disposable server; unset = embedded PostgreSQL
# TEST_DATABASE_URL=

# --- Business tenant (single-tenant runtime) ---
TENANT_ID=11111111-1111-4111-8111-111111111111
SESSION_SECRET=replace-with-at-least-32-random-characters
OWNER_EMAIL=owner@demo.opentradie.test
OWNER_PASSWORD=replace-with-a-strong-unique-password
VIEWER_EMAIL=viewer@demo.opentradie.test
VIEWER_PASSWORD=replace-with-another-strong-password
# seed only: 1500 = 15% GST
DEMO_TAX_BASIS_POINTS=1500

# --- Privacy and models ---
# LOCAL_ONLY | APPROVAL_REQUIRED | APPROVED_CLOUD
PRIVACY_MODE=LOCAL_ONLY
# mock (deterministic, no AI) | openclaw
AGENT_MODE=mock
# loopback ws:// or wss://; pinned client @openclaw/gateway-client 2026.10.8 (the Gateway must run the same version)
OPENCLAW_URL=ws://127.0.0.1:18789
OPENCLAW_TOKEN=
OPENCLAW_DEVICE_PATH=.data/openclaw-device.json
OPENCLAW_AGENT_ID=opentradie
# label of the provider configured inside OpenClaw, e.g. ollama
OPENCLAW_MODEL_PROVIDER=unconfigured
# operator attestation; set local only when OpenClaw uses local Ollama
OPENCLAW_INFERENCE_LOCATION=hosted
# Bearer secret (>= 32 chars) the OpenClaw Gateway sends to the agent tool gateway at
# /agent-tools/mcp (ADR 0021). Empty = tool gateway disabled. Store it in the Gateway's secrets.
AGENT_TOOL_TOKEN=
# none | ollama | openai_compatible
EMBEDDING_PROVIDER=none
# e.g. http://127.0.0.1:11434 (location is derived from this URL)
EMBEDDING_URL=
# must produce 768-dimension vectors, e.g. nomic-embed-text
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Voice note speech-to-text: none | whisper_cpp | openai_compatible | mock (mock: dev/tests/demos only;
# refused with NODE_ENV=production or the cloud profile). Non-loopback URLs are hosted and LOCAL_ONLY refuses them.
SPEECH_PROVIDER=none
# SPEECH_BASE_URL=http://127.0.0.1:8080
# SPEECH_MODEL=ggml-base.en

# --- Files ---
# local | s3 (required in the cloud profile)
FILE_STORE=local
FILE_STORE_PATH=.data/files
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Secrets ---
# 32 bytes hex (AES-256-GCM for provider credentials); required in cloud and with any
# ACCOUNTING_PROVIDER. Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
# id stored with each sealed row (default k1); change it when rotating the key
CREDENTIAL_ENCRYPTION_KEY_ID=
# Require owners to enrol TOTP two-factor before using the app (ADR 0031). Needs
# CREDENTIAL_ENCRYPTION_KEY. Recommended for the cloud profile.
REQUIRE_OWNER_MFA=false
# old keys kept only to decrypt existing rows after a rotation: id:hex,id:hex
CREDENTIAL_ENCRYPTION_RETIRED_KEYS=

# --- Accounting (ADR 0023) ---
# none | xero | fake (fake is a MOCK for demos/tests: needs ACCOUNTING_ALLOW_FAKE=true,
# refused in the cloud profile and with NODE_ENV=production)
ACCOUNTING_PROVIDER=none
ACCOUNTING_ALLOW_FAKE=false
# From your Xero app (developer.xero.com). Never commit real values.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# must equal the app's redirect URI, e.g. https://trades.example.com/api/integrations/xero/callback
XERO_REDIRECT_URI=
# NZ | AU tax type preset; confirm against your organisation's tax rates
XERO_TAX_PRESET=NZ
XERO_PKCE=true

# --- Mail (approved replies; ADR 0026) ---
# none | gmail | microsoft_graph | fake (fake is a MOCK: needs MAIL_ALLOW_FAKE=true,
# refused in the cloud profile and with NODE_ENV=production). Needs CREDENTIAL_ENCRYPTION_KEY.
MAIL_PROVIDER=none
MAIL_ALLOW_FAKE=false
# Google Cloud OAuth client (web application). Never commit real values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# e.g. https://trades.example.com/api/integrations/mail/gmail/callback
GMAIL_REDIRECT_URI=
# Microsoft Entra app registration. Never commit real values.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# e.g. https://trades.example.com/api/integrations/mail/microsoft_graph/callback
MS_GRAPH_REDIRECT_URI=
MS_GRAPH_TENANT=common

# --- Relay ---
# enables POST /relay/v1/events (HMAC-SHA256); unset = relay ingress off
RELAY_SHARED_SECRET=
# enables POST /inbound/email/:provider (HMAC-SHA256, 32+ chars); unset = inbound email webhook off
INBOUND_EMAIL_SECRET=
