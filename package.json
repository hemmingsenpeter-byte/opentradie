{
  "name": "opentradie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": ">=10.33.4 <11"
  },
  "scripts": {
    "setup:dev": "tsx scripts/setup.ts",
    "dev": "tsx scripts/dev.ts",
    "start": "node --env-file-if-exists=.env dist/api/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker/index.js",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "provision:tenant": "tsx scripts/provision-tenant.ts",
    "owner:reset-password": "tsx scripts/owner-reset-password.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @opentradie/web typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm --filter @opentradie/web run --if-present test",
    "test:integration": "vitest run tests",
    "test:backup": "tsx scripts/backup-test.ts",
    "test:restore-drill": "tsx scripts/restic-drill.ts",
    "backup:run": "tsx scripts/backup.ts run",
    "backup:restore": "tsx scripts/backup.ts restore",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:openclaw": "tsx scripts/openclaw-smoke.ts",
    "test:speech-smoke": "tsx scripts/speech-smoke.ts",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @opentradie/web build && tsup --config tsup.config.ts",
    "deploy:local": "node scripts/deploy.mjs local",
    "deploy:cloud": "node scripts/deploy.mjs cloud",
    "deploy:hybrid": "node scripts/deploy.mjs hybrid"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@eslint/js": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@opentradie/agent": "workspace:*",
    "@opentradie/api": "workspace:*",
    "@opentradie/core": "workspace:*",
    "@opentradie/database": "workspace:*",
    "@opentradie/documents": "workspace:*",
    "@opentradie/integrations": "workspace:*",
    "@opentradie/platform": "workspace:*",
    "@playwright/test": "catalog:",
    "@react-pdf/renderer": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "embedded-postgres": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
