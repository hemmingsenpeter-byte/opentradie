# Cloud profile template. Copy to deployments/cloud/.env (git-ignored) and fill in.
# Contains NO real secrets. Generate secrets yourself, for example:
#   SESSION_SECRET            openssl rand -base64 48
#   CREDENTIAL_ENCRYPTION_KEY openssl rand -hex 32
#   POSTGRES_PASSWORD         openssl rand -hex 24
# `pnpm deploy:cloud` refuses values that still look like placeholders.
DEPLOYMENT_PROFILE=cloud
POSTGRES_PASSWORD=change-me
SESSION_SECRET=replace-with-at-least-32-random-bytes
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-chars
TENANT_ID=replace-with-a-uuid-v4
# Public HTTPS origin served by your reverse proxy / platform (no trailing slash).
APP_ORIGIN=https://app.example.com
SECURE_COOKIES=true
# Privacy. Hosted models are denied unless PRIVACY_MODE=APPROVED_CLOUD (APPROVAL_REQUIRED
# scoped approvals are not enabled in this release). Choose APPROVED_CLOUD only if the
# business accepts that policy-permitted context reaches your configured model provider.
PRIVACY_MODE=APPROVED_CLOUD
OPENCLAW_INFERENCE_LOCATION=hosted
# mock is the safe default. openclaw needs a separate, isolated, tools-denied Gateway
# that you operate (docs/OPENCLAW_INTEGRATION.md). The Gateway is NOT part of this compose file.
AGENT_MODE=mock
OPENCLAW_URL=
OPENCLAW_TOKEN=
OPENCLAW_DEVICE_PATH=/app/.data/openclaw-device.json
# Demo seed accounts (only if you run `pnpm db:seed` against this database; not for production).
OWNER_EMAIL=
OWNER_PASSWORD=
VIEWER_EMAIL=
VIEWER_PASSWORD=
# File storage. Names for the S3 settings are finalised by the backend lane (TBD at merge).
FILE_STORE=local
FILE_STORE_PATH=/app/.data/files
# Optional S3-compatible storage (docker compose --profile s3):
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# Host publishing of the app port (keep loopback unless a proxy on another host needs it).
APP_BIND=127.0.0.1
APP_PORT=3000
# Accounting (ADR 0023): none | xero. The fake (mock) adapter is refused in the cloud profile.
# Unverified against Xero: see docs/integrations/accounting.md before enabling.
ACCOUNTING_PROVIDER=none
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=https://app.example.com/api/integrations/xero/callback
