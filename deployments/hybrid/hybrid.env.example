# Hybrid profile template: a local Mac mini is the ONLY authoritative runtime
# (database + OpenClaw Gateway + API). Copy to .env at the repo root. No real secrets here.
# Generate secrets with `pnpm setup:dev` in a scratch checkout or with openssl
# (see deployments/cloud/.env.example for commands).
DEPLOYMENT_PROFILE=hybrid
# --- Single-authority guard (checked by `pnpm deploy:hybrid`) ---
# Confirms THIS machine is the one authoritative runtime for this installation.
AUTHORITATIVE_RUNTIME=true
# The database MUST be loopback/local. Do not set CLOUD_/REMOTE_/SECONDARY_DATABASE_URL.
DATABASE_URL=postgres://opentradie:change-me@127.0.0.1:5432/opentradie
POSTGRES_PASSWORD=change-me
SESSION_SECRET=replace-with-at-least-32-random-bytes
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-chars
TENANT_ID=replace-with-a-uuid-v4
APP_ORIGIN=http://localhost:5173
PORT=3000
# --- Privacy ---
# LOCAL_ONLY: no business content leaves the machine; fails closed if local inference is down.
# Optional cloud inference requires APPROVED_CLOUD plus OPENCLAW_INFERENCE_LOCATION=hosted in this release.
PRIVACY_MODE=LOCAL_ONLY
OPENCLAW_INFERENCE_LOCATION=local
# --- Agent: one Gateway, on loopback, tools denied ---
AGENT_MODE=mock
OPENCLAW_URL=ws://127.0.0.1:18789
OPENCLAW_TOKEN=
OPENCLAW_DEVICE_PATH=.data/openclaw-device.json
# --- Files and backups ---
FILE_STORE=local
FILE_STORE_PATH=.data/files
# --- Remote access / inbound events: NOT IMPLEMENTED in v0.1 (see docs/RELAY.md) ---
# Options, all outbound-from-local or authenticated:
#   direct provider callback, secure tunnel (e.g. Tailscale/Cloudflare Tunnel), managed relay.
# Never expose the OpenClaw Gateway port. Leave these empty until a relay exists.
# RELAY_URL=
# RELAY_CLIENT_ID=
OWNER_EMAIL=owner@demo.opentradie.test
OWNER_PASSWORD=replace-with-a-strong-unique-password
VIEWER_EMAIL=viewer@demo.opentradie.test
VIEWER_PASSWORD=replace-with-another-strong-password
